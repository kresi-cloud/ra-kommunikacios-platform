# Pilot-ágens konfiguráció. Soha ne kerüljön bele valódi jelszó verziókezelésbe;
# ez a fájl csak a szükséges kulcsokat dokumentálja. Helyi futtatáshoz másold
# .env.pilot-agents néven (a .gitignore kizárja), CI-ban GitHub Secrets-ként add meg.

# A TEST Supabase projekt publikus adatai (nem service-role kulcs).
PILOT_SUPABASE_URL=[CONFIGURE_ME]
PILOT_SUPABASE_ANON_KEY=[CONFIGURE_ME]

# Kötelező három személyiség. A fiókokat előbb létre kell hozni a Supabase
# Dashboardon (Authentication → Users), majd a seed-profiles.sql-lel a
# megfelelő profilt és szerepkiosztást is meg kell adni nekik.
PILOT_LEAD_EMAIL=[CONFIGURE_ME]
PILOT_LEAD_PASSWORD=[CONFIGURE_ME]
PILOT_OWNER_EMAIL=[CONFIGURE_ME]
PILOT_OWNER_PASSWORD=[CONFIGURE_ME]
PILOT_STAFF_EMAIL=[CONFIGURE_ME]
PILOT_STAFF_PASSWORD=[CONFIGURE_ME]

# Opcionális negyedik személyiség, csak egy RLS-tiltási ellenőrzéshez kell.
# Hagyd üresen, ha nincs rá szükség.
PILOT_ADMIN_EMAIL=
PILOT_ADMIN_PASSWORD=
