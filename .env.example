# === Új, SQLite-alapú háttérrendszer (server/) ===
# Fejlesztésben véletlenszerű, hosszú string; élesben titokkezelőben tárolt,
# legalább 32 karakteres, véletlen érték. A munkamenet-sütiket ezzel írja alá
# a better-auth.
BETTER_AUTH_SECRET=[CONFIGURE_ME]
BETTER_AUTH_URL=http://localhost:5173

# Opcionális: Google-bejelentkezéshez. Üresen hagyva a Google-gomb inaktív marad.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcionális: a SQLite-fájl helye. Alapértelmezés: data/ra-kommunikacios-platform.sqlite
DATABASE_PATH=

# === Korábbi Supabase-integráció (átállás alatt, lásd docs/architecture.md) ===
# A projektek modulja (I1/A) és az azonosítás (I0) már az új háttérrendszeren
# fut; a feladat-, esemény- és értesítésmodul még a Supabase-en, amíg
# fokozatosan átkerül. Ezek a változók addig szükségesek azokhoz a
# felületekhez.
VITE_SUPABASE_URL=[CONFIGURE_ME]
VITE_SUPABASE_ANON_KEY=[CONFIGURE_ME]
VITE_APP_ENV=development
VITE_APP_TIMEZONE=Europe/Budapest

# Kizárólag helyi Supabase DB-teszthez; ne prefixeld VITE_-tal.
SUPABASE_DB_URL=[CONFIGURE_ME]
